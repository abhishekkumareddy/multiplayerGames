{
  "name": "friends-arcade",
  "version": "1.0.0",
  "description": "Multiplayer Friends Gaming Website without a database",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/server/src/server.js",
    "start:server": "node server/dist/server/src/server.js",
    "test": "node --test tests/room-manager.test.js tests/game-engines.test.js tests/e2e-socket.test.js tests/integration-api-cors-socket.test.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "chess.js": "^1.4.0",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
